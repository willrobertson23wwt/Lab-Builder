# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- vCloud Director tenant -------------------------------------------------
VCD_URL=https://vcd.example.com/api            # tenant API endpoint (note the /api suffix)
VCD_ORG=my-org                                  # organization name, as in the tenant portal URL
# Same account you use on the tenant portal's User name / Password form,
# or an API token (User preferences > API Tokens) if your org allows them.
VCD_AUTH_TYPE=integrated                        # or api_token
VCD_USER=your-portal-username
VCD_PASSWORD=your-portal-password
#VCD_API_TOKEN=
VCD_ALLOW_UNVERIFIED_SSL=false                  # true if the vCD certificate is not trusted on this machine

# --- Site defaults (discover them with scripts/discover.py and scripts/inventory.py) ---
TF_VAR_vcd_url=https://vcd.example.com/api      # same as VCD_URL
TF_VAR_vcd_org=my-org                           # same as VCD_ORG
TF_VAR_vdc=my-org-vdc-01                        # Org VDC holding the vApps      (discover.py)
TF_VAR_org_network=my-org-network-01            # routed Org VDC network         (inventory.py networks)
VCD_CATALOG=golden-images                       # catalog with the templates     (inventory.py catalogs)
TF_VAR_catalog=golden-images                    # same as VCD_CATALOG
TF_VAR_vapp_name=My-Existing-vApp               # only for terraform/ (power control of one imported vApp)
